@{
    var shift = (Shift)ViewBag.Shift;
    var canEdit = (bool)ViewBag.CanEdit;
    var accidents = (IReadOnlyList<Accident>)ViewBag.Accidents;
    ViewData["Title"] = "Accidents";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-1">Accident Log</h3>
        <span class="text-muted">
            @shift.ShiftType shift &mdash; @shift.ShiftDate.ToString("dd MMM yyyy") (@Display.ShiftWindow(shift))
            <span class="badge @shift.StatusBadge ms-1">@shift.Status</span>
        </span>
    </div>
    <div class="d-flex gap-2">
        @if (canEdit)
        {
            <a class="btn btn-danger" asp-action="Create" asp-route-shiftId="@shift.Id">+ Record accident</a>
        }
        <a class="btn btn-outline-secondary" asp-controller="Shifts" asp-action="Details" asp-route-id="@shift.Id">Back to shift</a>
    </div>
</div>

@if (!canEdit)
{
    <div class="alert alert-warning">
        @if (shift.Status == ShiftStatus.Closed)
        {
            <text>This shift is closed, so its accident records are read-only.</text>
        }
        else
        {
            <text>This shift is not yours. Only @shift.ClaimedBy?.FullName can add or edit accident records.</text>
        }
    </div>
}

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Time</th>
                    <th>Type</th>
                    <th>Severity</th>
                    <th>Location</th>
                    <th>Description &amp; action</th>
                    <th>Injured</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (accidents.Count == 0)
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">No accidents recorded on this shift.</td></tr>
                }
                @foreach (var accident in accidents)
                {
                    <tr>
                        <td class="text-nowrap">@Display.TimeOnly(accident.OccurredAt)</td>
                        <td>@Display.Humanise(accident.AccidentType)</td>
                        <td><span class="badge @accident.Severity.ToString().ToLower()">@Display.Humanise(accident.Severity)</span></td>
                        <td>@accident.Location</td>
                        <td style="min-width: 280px">
                            <div>@Display.Truncate(accident.Description, 160)</div>
                            <div class="small text-muted">Action: @Display.Truncate(accident.ImmediateActionTaken, 100)</div>
                            @if (accident.IsReportable)
                            {
                                <span class="badge bg-danger mt-1">Reportable to regulator</span>
                            }
                        </td>
                        <td class="text-center">@accident.PersonsInjured</td>
                        <td>@Display.Humanise(accident.InvestigationStatus)</td>
                        <td class="text-end text-nowrap">
                            @if (canEdit)
                            {
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@accident.Id">Edit</a>
                                <form asp-action="Delete" asp-route-id="@accident.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this accident record?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted small">Read only</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>