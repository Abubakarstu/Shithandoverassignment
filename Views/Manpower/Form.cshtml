@model ManpowerViewModel
@{
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit ? "Edit manpower" : "Add manpower";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card shadow-sm">
            <div class="card-header sh-card-header text-white">
                <h5 class="mb-0">@(isEdit ? "Edit manpower details" : "Add manpower details")</h5>
            </div>
            <div class="card-body">
                <div class="alert alert-info py-2 small">Shift: <strong>@Model.ShiftLabel</strong></div>

                <form asp-action="Save" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="ShiftId" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FunctionName" class="form-label"></label>
                            <input asp-for="FunctionName" class="form-control" list="functionList" placeholder="Ramp Operations" />
                            <datalist id="functionList">
                                <option value="Ramp Operations"></option>
                                <option value="Check-in & Boarding"></option>
                                <option value="Baggage Services"></option>
                                <option value="Safety & Fire"></option>
                                <option value="Security"></option>
                                <option value="Maintenance"></option>
                                <option value="Cargo"></option>
                            </datalist>
                            <span asp-validation-for="FunctionName" class="text-danger small"></span>
                            <div class="form-text">One row per function per shift. Saving an existing function updates it.</div>
                        </div>

                        <div class="col-md-2">
                            <label asp-for="Planned" class="form-label"></label>
                            <input asp-for="Planned" class="form-control" />
                            <span asp-validation-for="Planned" class="text-danger small"></span>
                        </div>
                        <div class="col-md-2">
                            <label asp-for="OnDuty" class="form-label"></label>
                            <input asp-for="OnDuty" class="form-control" />
                            <span asp-validation-for="OnDuty" class="text-danger small"></span>
                        </div>
                        <div class="col-md-2">
                            <label asp-for="OnLeave" class="form-label"></label>
                            <input asp-for="OnLeave" class="form-control" />
                        </div>

                        <div class="col-md-2">
                            <label asp-for="Absent" class="form-label"></label>
                            <input asp-for="Absent" class="form-control" />
                        </div>
                        <div class="col-md-2">
                            <label asp-for="Overtime" class="form-label"></label>
                            <input asp-for="Overtime" class="form-control" />
                        </div>
                        <div class="col-md-8">
                            <label asp-for="Remarks" class="form-label"></label>
                            <input asp-for="Remarks" class="form-control" placeholder="Cover arrangements, reassignments..." />
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">@(isEdit ? "Save changes" : "Add row")</button>
                        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-shiftId="@Model.ShiftId">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}