@model IncidentViewModel
@{
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit ? "Edit incident" : "Record incident";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card shadow-sm">
            <div class="card-header sh-card-header text-white">
                <h5 class="mb-0">@(isEdit ? "Edit incident record" : "Record an incident")</h5>
            </div>
            <div class="card-body">
                <div class="alert alert-info py-2 small">Shift: <strong>@Model.ShiftLabel</strong></div>

                <form asp-action="Save" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="ShiftId" />

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="OccurredAt" class="form-label"></label>
                            <input asp-for="OccurredAt" type="datetime-local" class="form-control" />
                            <span asp-validation-for="OccurredAt" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Category" class="form-label"></label>
                            <select asp-for="Category" asp-items="Model.CategoryList" class="form-select"></select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Severity" class="form-label"></label>
                            <select asp-for="Severity" asp-items="Model.SeverityList" class="form-select"></select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Location" class="form-label"></label>
                            <input asp-for="Location" class="form-control" placeholder="Terminal 1 - Check-in Row C" />
                            <span asp-validation-for="Location" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ReferenceNumber" class="form-label"></label>
                            <input asp-for="ReferenceNumber" class="form-control" placeholder="INC-2026-1143" />
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" rows="3" class="form-control"
                                      placeholder="What happened and the impact on operations..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="ActionTaken" class="form-label"></label>
                            <textarea asp-for="ActionTaken" rows="3" class="form-control"
                                      placeholder="Containment, workaround, ticket raised..."></textarea>
                            <span asp-validation-for="ActionTaken" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="InvestigationStatus" class="form-label"></label>
                            <select asp-for="InvestigationStatus" asp-items="Model.InvestigationStatusList" class="form-select"></select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="EscalatedTo" class="form-label"></label>
                            <input asp-for="EscalatedTo" class="form-control" placeholder="IT Operations Manager" />
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <div class="form-check mb-2">
                                <input class="form-check-input" asp-for="IsEscalated" />
                                <label class="form-check-label" asp-for="IsEscalated">Escalated</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">@(isEdit ? "Save changes" : "Record incident")</button>
                        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-shiftId="@Model.ShiftId">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}