@{
    var shift = (Shift)ViewBag.Shift;
    var canEdit = (bool)ViewBag.CanEdit;
    var incidents = (IReadOnlyList<Incident>)ViewBag.Incidents;
    ViewData["Title"] = "Incidents";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-1">Incident Log</h3>
        <span class="text-muted">
            @shift.ShiftType shift &mdash; @shift.ShiftDate.ToString("dd MMM yyyy") (@Display.ShiftWindow(shift))
            <span class="badge @shift.StatusBadge ms-1">@shift.Status</span>
        </span>
    </div>
    <div class="d-flex gap-2">
        @if (canEdit)
        {
            <a class="btn btn-warning" asp-action="Create" asp-route-shiftId="@shift.Id">+ Record incident</a>
        }
        <a class="btn btn-outline-secondary" asp-controller="Shifts" asp-action="Details" asp-route-id="@shift.Id">Back to shift</a>
    </div>
</div>

@if (!canEdit)
{
    <div class="alert alert-warning">
        @if (shift.Status == ShiftStatus.Closed)
        {
            <text>This shift is closed, so its incident records are read-only.</text>
        }
        else
        {
            <text>This shift is not yours. Only @shift.ClaimedBy?.FullName can add or edit incident records.</text>
        }
    </div>
}

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Time</th>
                    <th>Category</th>
                    <th>Severity</th>
                    <th>Location</th>
                    <th>Reference</th>
                    <th>Description &amp; action</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (incidents.Count == 0)
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">No incidents recorded on this shift.</td></tr>
                }
                @foreach (var incident in incidents)
                {
                    <tr>
                        <td class="text-nowrap">@Display.TimeOnly(incident.OccurredAt)</td>
                        <td>@Display.Humanise(incident.Category)</td>
                        <td><span class="badge @incident.Severity.ToString().ToLower()">@Display.Humanise(incident.Severity)</span></td>
                        <td>@incident.Location</td>
                        <td class="small">@(incident.ReferenceNumber ?? "-")</td>
                        <td style="min-width: 260px">
                            <div>@Display.Truncate(incident.Description, 150)</div>
                            <div class="small text-muted">Action: @Display.Truncate(incident.ActionTaken, 100)</div>
                            @if (incident.IsEscalated)
                            {
                                <span class="badge bg-danger mt-1">Escalated to @(incident.EscalatedTo ?? "-")</span>
                            }
                        </td>
                        <td>@Display.Humanise(incident.InvestigationStatus)</td>
                        <td class="text-end text-nowrap">
                            @if (canEdit)
                            {
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@incident.Id">Edit</a>
                                <form asp-action="Delete" asp-route-id="@incident.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this incident record?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted small">Read only</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>