@model ShiftListViewModel
@{
    ViewData["Title"] = "Shifts";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Shift Schedule</h3>
    @if (Model.IsAdmin)
    {
        <a class="btn btn-outline-primary" asp-action="Generate">Generate shift roster</a>
    }
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-6 col-lg-3">
                <label class="form-label small mb-1">Status</label>
                <select name="StatusFilter" class="form-select form-select-sm">
                    <option value="">All statuses</option>
                    @foreach (var status in Enum.GetValues<ShiftStatus>())
                    {
                        <option value="@status" selected="@(Model.StatusFilter == status ? "selected" : null)">@Display.Humanise(status)</option>
                    }
                </select>
            </div>
            <div class="col-6 col-lg-3">
                <label class="form-label small mb-1">From date</label>
                <input type="date" name="FromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-6 col-lg-3">
                <label class="form-label small mb-1">To date</label>
                <input type="date" name="ToDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-6 col-lg-2 d-flex align-items-center">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="MineOnly" value="true" id="mineOnly" checked="@Model.MineOnly" />
                    <label class="form-check-label small" for="mineOnly">Only my shifts</label>
                </div>
            </div>
            <div class="col-12 col-lg-1 d-grid">
                <button class="btn btn-sm btn-primary" type="submit">Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-4"><div class="alert alert-secondary py-2 mb-0"><strong>@Model.OpenCount</strong> open</div></div>
    <div class="col-4"><div class="alert alert-info py-2 mb-0"><strong>@Model.ClaimedCount</strong> claimed</div></div>
    <div class="col-4"><div class="alert alert-success py-2 mb-0"><strong>@Model.ClosedCount</strong> closed</div></div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Date</th>
                    <th>Shift</th>
                    <th>Window</th>
                    <th>Area</th>
                    <th>Status</th>
                    <th>Claimed by</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Shifts.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">No shifts match the selected filters.</td>
                    </tr>
                }
                @foreach (var shift in Model.Shifts)
                {
                    var isMine = shift.ClaimedById == Model.CurrentSupervisorId;
                    <tr>
                        <td>@shift.ShiftDate.ToString("dd MMM yyyy")</td>
                        <td>@shift.ShiftType</td>
                        <td>@Display.ShiftWindow(shift)</td>
                        <td>@(shift.Area ?? "-")</td>
                        <td><span class="badge @shift.StatusBadge">@shift.Status</span></td>
                        <td>
                            @if (shift.ClaimedBy is not null)
                            {
                                <span>@shift.ClaimedBy.FullName</span>
                                <span class="text-muted small">@shift.ClaimedBy.EmployeeCode</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@shift.Id">View</a>
                            @if (shift.Status == ShiftStatus.Open)
                            {
                                <form asp-action="Claim" asp-route-id="@shift.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-primary">Claim</button>
                                </form>
                            }
                            else if (isMine && shift.Status == ShiftStatus.Claimed)
                            {
                                <span class="badge bg-primary-subtle text-primary">Yours</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>