@{
    var shifts = (List<Shift>)ViewBag.Shifts;
    var isAdmin = (bool)ViewBag.IsAdmin;
    var auditLogs = (List<AuditLog>)ViewBag.AuditLogs;
    ViewData["Title"] = "Reports";
}

<h3 class="mb-3">Handover Reports</h3>

<div class="card mb-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Shift</th>
                    <th>Date</th>
                    <th>Window</th>
                    <th>Supervisor</th>
                    <th>Closed</th>
                    <th class="text-center">Acc</th>
                    <th class="text-center">Inc</th>
                    <th class="text-center">MP</th>
                    <th class="text-center">E-mailed</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (shifts.Count == 0)
                {
                    <tr><td colspan="10" class="text-center text-muted py-4">No shifts have been closed yet.</td></tr>
                }
                @foreach (var shift in shifts)
                {
                    var report = shift.Reports.OrderByDescending(x => x.GeneratedAt).FirstOrDefault();
                    <tr>
                        <td><strong>@shift.ShiftType</strong></td>
                        <td>@shift.ShiftDate.ToString("dd MMM yyyy")</td>
                        <td>@Display.ShiftWindow(shift)</td>
                        <td>@shift.ClosedBy?.FullName</td>
                        <td>@(shift.ClosedAt.HasValue ? Display.Pretty(shift.ClosedAt.Value) : "-")</td>
                        <td class="text-center">@(report?.AccidentCount ?? 0)</td>
                        <td class="text-center">@(report?.IncidentCount ?? 0)</td>
                        <td class="text-center">@(report?.ManpowerRowCount ?? 0)</td>
                        <td class="text-center">
                            @if (report is null)
                            {
                                <span class="badge bg-secondary">Not generated</span>
                            }
                            else if (report.EmailedSuccessfully)
                            {
                                <span class="badge bg-success">Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Outbox</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Preview" asp-route-shiftId="@shift.Id" target="_blank">Preview</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Download" asp-route-shiftId="@shift.Id">Download</a>
                            @if (isAdmin)
                            {
                                <form asp-action="Resend" asp-route-shiftId="@shift.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-warning">Re-send</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<h5 class="mb-2">Audit trail</h5>
<div class="card">
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>When</th>
                    <th>Entity</th>
                    <th>#</th>
                    <th>Action</th>
                    <th>Details</th>
                    <th>User</th>
                </tr>
            </thead>
            <tbody>
                @if (auditLogs.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-3">No audit entries.</td></tr>
                }
                @foreach (var log in auditLogs)
                {
                    <tr>
                        <td class="text-nowrap small">@Display.Pretty(log.CreatedAt)</td>
                        <td>@log.EntityName</td>
                        <td>@log.EntityId</td>
                        <td><span class="badge bg-light text-dark border">@log.Action</span></td>
                        <td class="small">@log.Details</td>
                        <td class="small">@log.UserName</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>